<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<artifactId>bjl_core</artifactId>
	<name>Bringardner Java Library Core</name>
	<groupId>us.bringardner</groupId>
	<version>1.3.0-SNAPSHOT</version>

	<description>This project holds the Core (or Common) components that are
		used by
		most if not all other projects in the Bringardner Java Library as well
		as some utility
		classes that have frequent references from other packages. The main
		objective of these classes is to provide basic functionality such as
		logging with a minimum of external dependencies. </description>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<maven.compiler.release>11</maven.compiler.release>
		<junit.version>5.11.4</junit.version>
		<log4j.version>2.24.3</log4j.version>
		<jacoco.version>0.8.15</jacoco.version>
	</properties>

	<build>
		<!-- <sourceDirectory>src</sourceDirectory> -->
		<testResources>
			<testResource>
				<directory>src/test/resources</directory>
			</testResource>
			<!-- Example logging configurations (log4j2.xml, JulLogging.properties) used by the logger tests.
			     They are test resources only so they are not packaged in the library jar. -->
			<testResource>
				<directory>resources</directory>
			</testResource>
		</testResources>

		<plugins>
			<!--
			  Multi-release jar (BJL-6): everything is compiled for Java 11 as before; the few
			  classes in src/main/java21 are compiled for Java 21 into META-INF/versions/21, where
			  only Java 21+ JVMs look. The library still runs on Java 11; building it needs JDK 21+.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<executions>
					<execution>
						<id>java21</id>
						<goals>
							<goal>compile</goal>
						</goals>
						<configuration>
							<release>21</release>
							<compileSourceRoots>
								<compileSourceRoot>${project.basedir}/src/main/java21</compileSourceRoot>
							</compileSourceRoots>
							<multiReleaseOutput>true</multiReleaseOutput>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!--
			  The JVM only picks META-INF/versions/21 from inside a jar; surefire tests
			  target/classes (the Java 11 classes). Tests named *IT run in 'mvn verify' against
			  the built jar, so on JDK 21+ they test the Java 21 classes.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<version>3.5.2</version>
				<executions>
					<execution>
						<goals>
							<goal>integration-test</goal>
							<goal>verify</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<!-- Plugins listed only in pluginManagement are NOT executed, so the source jar is declared here. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-source-plugin</artifactId>
			</plugin>
			<!-- A fixed module name for projects that use Java modules (no module-info.java needed) -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<version>3.4.2</version>
				<configuration>
					<archive>
						<manifestEntries>
							<Automatic-Module-Name>us.bringardner.core</Automatic-Module-Name>
							<!-- Java 21+ JVMs use the classes in META-INF/versions/21 (BJL-6) -->
							<Multi-Release>true</Multi-Release>
						</manifestEntries>
					</archive>
				</configuration>
			</plugin>
			<!-- Code coverage: 'mvn verify' writes the report to target/site/jacoco/index.html -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
			</plugin>
		</plugins>

		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<version>3.13.0</version>
					<configuration>
						<release>${maven.compiler.release}</release>
					</configuration>
				</plugin>

				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-source-plugin</artifactId>
					<version>3.3.1</version>
					<executions>
						<execution>
							<id>attach-sources</id>
							<goals>
								<goal>jar-no-fork</goal>
							</goals>
							<!-- package (not deploy) so the source jar is attached BEFORE the deploy plugin runs -->
							<phase>package</phase>
							<configuration>
								<skipSource>false</skipSource>
								<attach>true</attach>
							</configuration>
						</execution>
					</executions>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-deploy-plugin</artifactId>
					<version>3.1.4</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<version>3.5.2</version>
					<!-- If an argLine is ever added here, write it as <argLine>@{argLine} ...</argLine>
					     so it does not replace the JaCoCo agent set by prepare-agent. -->
				</plugin>

				<plugin>
					<groupId>org.jacoco</groupId>
					<artifactId>jacoco-maven-plugin</artifactId>
					<version>${jacoco.version}</version>
					<executions>
						<!-- Attaches the JaCoCo agent to the surefire test JVM -->
						<execution>
							<id>prepare-agent</id>
							<goals>
								<goal>prepare-agent</goal>
							</goals>
						</execution>
						<!-- HTML, XML and CSV reports in target/site/jacoco -->
						<execution>
							<id>report</id>
							<phase>verify</phase>
							<goals>
								<goal>report</goal>
							</goals>
							<configuration>
								<!-- The Java 21 copies of multi-release classes (BJL-6) have the same
								     names as the Java 11 ones, which the report can't hold twice -->
								<excludes>
									<exclude>META-INF/versions/**</exclude>
								</excludes>
							</configuration>
						</execution>
					</executions>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>

	<distributionManagement>
		<repository>
			<id>github</id>
			<name>tony-bringardner</name>
			<url>https://maven.pkg.github.com/tony-bringardner/BjlCore</url>
		</repository>

	</distributionManagement>

	<url>http://bringardner.us/BJL/BjlCore</url>
	<inceptionYear>1998</inceptionYear>

	<licenses>
		<license>
			<name>Apache License, Version 2.0</name>
			<url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
			<distribution>repo</distribution>
		</license>
	</licenses>

	<scm>
		<url>https://github.com/tony-bringardner/BjlCore</url>
		<connection>scm:git:https://github.com/tony-bringardner/BjlCore.git</connection>
		<developerConnection>scm:git:https://github.com/tony-bringardner/BjlCore.git</developerConnection>
	</scm>

	<dependencies>
		<!-- log4j is only used for testing, Log4JLogger accesses it by reflection at runtime.
		     2.13.2 was vulnerable to Log4Shell (CVE-2021-44228). -->
		<dependency>
			<groupId>org.apache.logging.log4j</groupId>
			<artifactId>log4j-api</artifactId>
			<version>${log4j.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.logging.log4j</groupId>
			<artifactId>log4j-core</artifactId>
			<version>${log4j.version}</version>
			<scope>test</scope>
		</dependency>
		<!-- junit-jupiter includes the API (to compile tests) and the engine (to run them) -->
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>${junit.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
